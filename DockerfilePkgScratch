# ===== STAGE 1: BUILDER =====
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build && \
    npx pkg dist/server.js --target node18-linux-x64 --output server

# ===== STAGE 2: RUNTIME (Alpine + glibc compat) =====
FROM alpine:3.20 AS runtime
WORKDIR /app
# Install glibc compatibility for pkg binaries (musl -> glibc)
RUN apk add --no-cache libstdc++ gcompat
COPY --from=builder /app/server /server
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
USER 1000:1000
EXPOSE 3000
ENTRYPOINT ["/server"]