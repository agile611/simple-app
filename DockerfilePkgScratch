# ===== STAGE 1: BUILDER =====
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build && \
    npx pkg dist/server.js --target node20-linux-x64 --output server

# ===== STAGE 2: RUNTIME (Scratch) =====
FROM scratch AS runtime
WORKDIR /app
COPY --from=builder /app/server /server
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/
USER 1000:1000
EXPOSE 3000
ENTRYPOINT ["/server"]
